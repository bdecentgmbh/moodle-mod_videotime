{{!
    @template mod_videotime/videotime_instance

    This template will render the video time activity and load player

    Variables required for this template:
    * video_description - vimeo video descript
    * intro - activity description
    * uniqueid - Unique id of player on page
    * cmid - course module id
    * haspro - whether pro features are available
    * interval - save position update interval

    Variables optional for this template:
    * next_activity_button_html - markup for next activity button
    * theatremodeurl - link to theatre mode
    * theatremode - breadcrumb and exit link when in theatre mode

    Example context (json):
    {
        "intro": "Watch this",
        "uniqueid": "60dccff8871f6",
        "next_activity_button_html": "<button>Next</button>",
        "player": "<iframe></iframe>",
        "video_description": "UX design tips",
        "theatremodeurl": "#"
    }

}}
{{#instance}}
    {{#theatremode}}
        <div class="videotime-theatre-bar d-flex align-items-center mb-1">
            <h1 class="accesshide">{{{ name }}}</h1>
            <div class="videotime-theatre-navbar flex-grow-1">
                {{{ navbar }}}
            </div>
            <a class="videotime-theatre-close btn btn-icon flex-shrink-0" href="{{ exiturl }}"
                title="{{# str }} exittheatremode, mod_videotime {{/ str }}"
                aria-label="{{# str }} exittheatremode, mod_videotime {{/ str }}"
            >{{# pix }} e/cancel, core {{/ pix }}</a>
        </div>
    {{/theatremode}}

    <div class="container-fluid position-relative{{#theatremode}} videotime-theatre mx-auto{{/theatremode}}">
        <div class="videotime-toolbar d-flex justify-content-end align-items-start">
            {{! The button does not link to theatre mode, but the player script updates it. }}
            <div id="next-activity-button"{{#theatremode}} class="d-none"{{/theatremode}}>
                {{{next_activity_button_html}}}
            </div>
            {{#theatremodeurl}}
                <a class="btn btn-secondary mb-2" href="{{ theatremodeurl }}">
                    {{# pix }} e/fullscreen, core {{/ pix }}{{# str }} theatremode, mod_videotime {{/ str }}
                </a>
            {{/theatremodeurl}}
        </div>
    {{^tabshtml}}
        {{{ intro }}}
        {{{ player }}}
    {{/tabshtml}}
    {{#tabshtml}}
        {{{ intro }}}
        <div class="videotimetabs">
            {{{tabshtml}}}
            <div class="videotime-tab-instance">
                {{{ player }}}
            </div>
            <div class="videotime-tab-instance-cover"></div>
        </div>
    {{/tabshtml}}
    </div>
{{/instance}}
